{
  "collections": [
    {
      "name": "subscriptions",
      "description": "Stores Web Push subscriptions for notifications.",
      "securityRules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      },
      "documentSchema": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "keys": {
            "type": "object",
            "properties": {
              "p256dh": {
                "type": "string"
              },
              "auth": {
                "type": "string"
              }
            }
          }
        },
        "required": ["endpoint", "keys"]
      }
    }
  ]
}
